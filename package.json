{
  "name": "known-world-validation",
  "private": true,
  "version": "0.0.0",
  "description": "Known World acceptance runners; game code remains in index.html",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:syntax": "node validation/static-checks.mjs",
    "validate:core": "node validation/run-local.mjs core",
    "validate:focused": "node validation/run-local.mjs focused",
    "validate:browser": "node validation/browser-run.mjs slice",
    "validate:native-smoke": "node validation/browser-run.mjs native-smoke",
    "validate:native-established": "node validation/established-native.mjs",
    "validate:coverage": "node validation/verify-coverage.mjs",
    "validate:native-v2": "node validation/native-v2.mjs",
    "validate:roadmap": "node tools/sync-progress-status.mjs --check"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
